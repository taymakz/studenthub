{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "university",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "type": "string", "enum": ["azad", "gov", "pnu"] },
    "name": {
      "type": "object",
      "properties": {
        "fa": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      },
      "required": ["fa"],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "fa": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      },
      "required": ["fa"],
      "additionalProperties": false
    }
  },
  "required": ["slug", "name", "type", "location"],
  "additionalProperties": false
}

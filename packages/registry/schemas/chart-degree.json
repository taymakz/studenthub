{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chart-degree",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "type": { "type": "string", "const": "chart-degree" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": {
      "type": "object",
      "properties": {
        "fa": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      },
      "required": ["fa"],
      "additionalProperties": false
    },
    "termCount": { "type": "integer", "minimum": 1 },
    "maxTermCount": { "type": "integer", "minimum": 1 }
  },
  "required": ["slug", "name", "termCount", "maxTermCount"],
  "additionalProperties": false
}

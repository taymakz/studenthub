{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "major",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "type": { "type": "string", "const": "major" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": {
      "type": "object",
      "properties": {
        "fa": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      },
      "required": ["fa"],
      "additionalProperties": false
    },
    "degrees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": {
            "type": "object",
            "properties": {
              "fa": { "type": "string" },
              "en": { "type": "string" }
            },
            "required": ["fa"],
            "additionalProperties": false
          },
          "termCount": { "type": "integer", "minimum": 1, "maximum": 20 }
        },
        "required": ["slug", "name", "termCount"],
        "additionalProperties": false
      }
    }
  },
  "required": ["slug", "name"],
  "additionalProperties": false
}

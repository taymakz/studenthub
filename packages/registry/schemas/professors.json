{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "professors",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "type": { "type": "string", "const": "professors" },
    "professors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "department": { "type": "string" }
        },
        "required": ["slug", "name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["professors"],
  "additionalProperties": false
}

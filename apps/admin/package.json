    "@workspace/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "4.4.0-0",
    "embla-carousel-react": "^8.6.0",
    "gradient-border-plugin": "^1.1.3",

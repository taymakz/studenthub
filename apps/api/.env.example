# Database — Postgres connection string (docker: localhost:5433, prod: Supabase pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/studenthub

# Telegram bot — used for TMA initData validation, admin OTP, web login, and notifications
TELEGRAM_BOT_TOKEN=

# HS256 secret for admin + mini-app JWTs — generate: openssl rand -base64 48
SECRET_KEY=change-me

# Inline “Open app” button URL under notification messages
TELEGRAM_APP_URL=

# Skip real Bot API calls in local dev (messages are logged)
TELEGRAM_DRY=true

# CORS — comma-separated allowed origins for mini-app + admin dashboard
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# API port
PORT=8000

# Supabase Storage (S3-compatible) — one-time export images (weekly/exam)
SUPABASE_S3_ENDPOINT=https://qprhvhahqruacesgpjfm.storage.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=one-time
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Admin forum topics — combined format "chatId_threadId" (e.g. -1001234567890_14)
# DEFAULT receives feedback + generic ops; JOINS new signups; STORAGE uploads
TELEGRAM_SERVICE_TOPICS_DEFAULT_ID=
TELEGRAM_SERVICE_TOPICS_JOINS_ID=
TELEGRAM_SERVICE_TOPICS_STORAGE_ID=

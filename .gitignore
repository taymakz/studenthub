# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — per-project only, no root .env (enterprise)
.env*
!apps/*/.env.example
!apps/*/*/.env.example
!packages/*/.env.example

# db dumps — enterprise: never commit PII or raw sql
*.sql
*.dump
dump.sql
studenthub_dump.sql
dump/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
_ignore

# enterprise: local tooling & sensitive artifacts — never commit
.freebuff/
FUTURE.md
.turbo/
coverage/
.sentry/
*.log

# @workspace/cli exporter output — raw university data, never commit
packages/cli/output/
